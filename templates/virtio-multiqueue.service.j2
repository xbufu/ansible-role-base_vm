[Unit]
Description=Set VirtIO NIC multiqueue channels
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for iface in /sys/class/net/eth* /sys/class/net/ens*; do \
  [ -e "$iface" ] && /usr/sbin/ethtool -L $(basename $iface) combined $(nproc); \
done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
